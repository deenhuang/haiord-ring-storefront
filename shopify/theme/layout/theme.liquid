<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ 'noor-shopify.css' | asset_url | stylesheet_tag }}
    {{ 'noor-gallery.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'noor-gallery.js' | asset_url }}" type="module"></script>
    {{ content_for_header }}
  </head>
  <body>
    {% unless template.name == 'index' %}
      <header class="noor-store-header">
        <a class="noor-store-logo" href="{{ routes.root_url }}">HAIORD <span>元序</span></a>
        <nav aria-label="{{ 'noor.navigation' | t }}">
          <a href="{{ routes.root_url }}">{{ 'noor.home' | t }}</a>
          <a href="{{ routes.all_products_collection_url }}">{{ 'noor.shop' | t }}</a>
          <a href="{{ routes.cart_url }}">{{ 'noor.cart' | t }} ({{ cart.item_count }})</a>
        </nav>
      </header>
    {% endunless %}
    <main id="MainContent">{{ content_for_layout }}</main>
    {% unless template.name == 'index' %}
      <footer class="noor-store-footer">&copy; {{ 'now' | date: '%Y' }} HAIORD Ring</footer>
    {% endunless %}
    <script src="{{ 'noor-shopify.js' | asset_url }}" defer></script>
  </body>
</html>

